{
    "name": "splicewire/laravel-beam-taxonomy",
    "description": "Beam taxonomy — the reusable Tag/Silo (BeamTag/BeamSilo) surface for beam sites. Ships the tag/silo ParticleResource declarations over host-bound models, so a beam site gets a schema-typed taxonomy CRUD surface with no controller code.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "splicewire/laravel-beam": "*",
        "splicewire/laravel-beam-sync": "*",
        "rushing/laravel-data-filters": "*",
        "rushing/laravel-permission-cascade": "*",
        "spatie/laravel-data": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-query-builder": "^5.0|^6.0|^7.0",
        "spatie/laravel-typescript-transformer": "^2.0|^3.0",
        "schemastud/laravel-data-schemas": "*",
        "laravel/scout": "^10.0",
        "cviebrock/eloquent-sluggable": "*",
        "staudenmeir/laravel-adjacency-list": "*",
        "mehdi-fathi/eloquent-filter": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Beam\\Taxonomy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Beam\\Taxonomy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Splicewire\\Beam\\Taxonomy\\BeamTaxonomyServiceProvider"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        },
        "package-topology": {
            "because": "beam-taxonomy owns the reusable Tag/Silo (BeamTag/BeamSilo) model cone; it depends DOWN on beam + the sync/data-filters/permission-cascade foundations and must NEVER reach UP into tower / satellite / the host App tier.",
            "policy": {
                "noRequire": [
                    { "fromPrefix": "splicewire/laravel-beam-taxonomy", "toPrefix": "splicewire/laravel-tower", "because": "the taxonomy cone is reusable by any beam site; it never requires tower/tenancy (host relations + tenant-sync stay in the App\\ subclass shim)" },
                    { "fromPrefix": "splicewire/laravel-beam-taxonomy", "toPrefix": "splicewire/laravel-satellite", "because": "the foundation never reaches up into the consumer-app tier" }
                ]
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    }
}
